{
  "name": "voetbalclub-game",
  "version": "0.1.0",
  "description": "Turn-based simulatie: jij bent eigenaar van een kleine Belgische voetbalclub in 3de nationale.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "balance": "tsx scripts/balance.ts",
    "investors": "tsx scripts/investor-value.ts",
    "autopilot": "tsx scripts/autopilot.ts",
    "economie": "tsx scripts/economie.ts"
  },
  "devDependencies": {
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^5.1.2",
    "mocha": "^11.0.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  }
}
