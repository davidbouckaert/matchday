{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matchday",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
